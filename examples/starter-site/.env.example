# Copy to .env and adjust. Never commit .env.
RB_SITE_NAME="Starter Site"
RB_BASE_URL=http://localhost:8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RB_SECRET_KEY=
RB_DATABASE_URL=sqlite:///./site.db
# RB_DATABASE_URL=postgresql+psycopg://redblue:redblue@localhost:5432/redblue
RB_STORAGE_DIR=./media
RB_EMAIL_PROVIDER=console
# RB_EMAIL_PROVIDER=smtp
# RB_SMTP_HOST=smtp.example.com
RB_EMAIL_FROM=hello@example.com
RB_THEME_TOKENS={"light": {"bg": "#ffffff", "surface": "#f6f7f9", "text": "#14161a", "muted": "#555b66", "border": "#dde1e7", "primary": "#1f4fd1", "primary_text": "#ffffff", "accent": "#c2185b", "danger": "#b3261e", "success": "#1b7a3d", "warning": "#8a5a00"}}
# Bring your own key to enable agents (use a spend-limited key):
# ANTHROPIC_API_KEY=
RB_AGENT_SPEND_LIMIT_USD=5
